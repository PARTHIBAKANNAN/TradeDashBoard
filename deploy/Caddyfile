# Caddy reverse proxy with automatic Let's Encrypt HTTPS.
# Replace the domain with your DuckDNS subdomain. Install Caddy, put this at
# /etc/caddy/Caddyfile, then: sudo systemctl reload caddy
#
# Requires ports 80 + 443 open (Oracle VCN Security List AND the host firewall).
#
# Everything the backend actually owns must be routed explicitly by path
# prefix — anything NOT matched here falls through to the static file_server,
# which will silently 200 with index.html instead of erroring. This has bitten
# us twice already: /callback (FYERS OAuth redirect) and /ws/* (the live
# WebSocket stream) both looked like "nothing works" bugs in the app before
# anyone noticed Caddy itself was never forwarding those specific paths.

trading-dashboard-1.duckdns.org {
    handle /api/* {
        reverse_proxy localhost:8000
    }
    handle /callback* {
        reverse_proxy localhost:8000
    }
    handle /ws/* {
        reverse_proxy localhost:8000
    }
    handle {
        root * /home/ubuntu/app/frontend/dist
        file_server
        try_files {path} /index.html
    }
}
